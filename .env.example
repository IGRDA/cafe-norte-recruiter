# Names and descriptions only. Copy to the git-ignored .env for `make run`. No secret values here.
# Every variable has a working default for local development with fakes unless marked (required).

# --- application ---------------------------------------------------------------------------
CAFE_NORTE_ENV=local                    # local | demo; selects defaults and log format
CAFE_NORTE_ACCESS_CODE=                 # shared demo access code (POST /api/access); empty means open access (local only)
CAFE_NORTE_COOKIE_SECRET=               # signs session cookies; empty means a new secret per process (local only)
CAFE_NORTE_CONFIG_DIR=config            # store configurations (YAML)
CAFE_NORTE_WEB_DIR=web                  # static browser files
CAFE_NORTE_PUBLIC_URL=http://localhost:8000
CAFE_NORTE_SESSION_SECONDS=480          # active conversation cap per session (8 minutes)
CAFE_NORTE_MAX_VOICE_SESSIONS=2         # admission slots, enforced in Postgres
CAFE_NORTE_LLM_FIRST_OUTPUT_SECONDS=6
CAFE_NORTE_TOOL_SECONDS=10
CAFE_NORTE_MAX_ANSWER_CHARACTERS=600    # a model round that speaks more than this is cut
CAFE_NORTE_COMMIT_SHA=local             # stamped on every export; the image build sets it to the git SHA

# --- model ----------------------------------------------------------------------------------
CAFE_NORTE_MODEL=fake                   # fake | groq/openai/gpt-oss-120b | groq/openai/gpt-oss-20b | openai/gpt-4o-mini
CAFE_NORTE_SIGNAL_MODEL=                # optional frustration classifier, e.g. openai/gpt-4o-mini; unset = off
GROQ_API_KEY=                           # (required for a groq/* model)
OPENAI_API_KEY=                         # (required for an openai/* model; local alternative to Groq's free-tier quotas)

# --- persistence ----------------------------------------------------------------------------
CAFE_NORTE_DATABASE_URL=                # empty = memory store, no Docker; postgresql://cafe:cafe@localhost:5432/cafe_norte after `make db-up`
CAFE_NORTE_DB_POOL_SIZE=5               # connections per process
CAFE_NORTE_TEST_DATABASE_URL=           # set to run the postgres-marked tests (make test-db)

# --- knowledge --------------------------------------------------------------------------------
CAFE_NORTE_RETRIEVER=lexical            # lexical (BM25 over kb/ at startup, no extra) | hybrid (artifact + FastEmbed, the image default)
CAFE_NORTE_KB_INDEX=kb/index            # versioned artifact built by `make build-index` (needs --extra knowledge)
CAFE_NORTE_KB_DIR=kb                    # the Markdown documents
CAFE_NORTE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- voice ------------------------------------------------------------------------------------
CAFE_NORTE_VOICE=off                    # off | browser (Web Speech, free, local; until hosted voice is verified) | pipecat (Daily + Deepgram + ElevenLabs)
DAILY_API_KEY=                          # (required for voice)
DEEPGRAM_API_KEY=                       # (required for voice)
ELEVENLABS_API_KEY=                     # (required for voice)
ELEVENLABS_VOICE_ID=                    # chosen after the bilingual listening check

# --- observability ----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=                    # tracing export is off when these are empty
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU region
CAFE_NORTE_TRACE_CONTENT=off            # on: truncated, redacted conversation text in traces

# --- evaluation (local only) ------------------------------------------------------------------
EVAL_URL=http://localhost:8000
EVAL_JUDGE=off                          # off | provider/model-id used by rubric judges
EVAL_SIMULATOR=off                      # off | provider/model-id that plays the candidate in live runs
